# Maintainer: Hec <hec@heccraft.com> (upstream); vendored into Olympus
pkgname=uupd
pkgver=0.2.7 # renovate: datasource=github-releases depName=bootc-dev/uupd
pkgrel=1
pkgdesc='User-level update daemon for bootc systems'
arch=('x86_64' 'aarch64')
url='https://github.com/bootc-dev/uupd'
license=('Apache-2.0')
depends=('systemd' 'podman')
makedepends=('go' 'just')
source=("git+${url}.git#tag=v${pkgver}")
sha256sums=('SKIP')

build() {
    cd "${srcdir}/uupd"
    just build
}

package() {
    cd "${srcdir}/uupd"
    install -Dm0755 bin/uupd "${pkgdir}/usr/bin/uupd"
    install -Dm0644 contrib/systemd/uupd.service "${pkgdir}/usr/lib/systemd/system/uupd.service"
    install -Dm0644 contrib/systemd/uupd.timer "${pkgdir}/usr/lib/systemd/system/uupd.timer"
    install -Dm0644 contrib/polkit/org.bootc.uupd.policy \
        "${pkgdir}/usr/share/polkit-1/actions/org.bootc.uupd.policy"
    install -Dm0644 contrib/completions/uupd.bash \
        "${pkgdir}/usr/share/bash-completion/completions/uupd"
    install -Dm0644 contrib/completions/_uupd \
        "${pkgdir}/usr/share/zsh/site-functions/_uupd"
    install -Dm0644 contrib/completions/uupd.fish \
        "${pkgdir}/usr/share/fish/vendor_completions.d/uupd.fish"
}
