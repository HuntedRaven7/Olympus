# Vendored from the AUR shim-signed submodule of hecknt/arch-bootc-pkgs.
# Provides the shim + MOK manager EFI binaries required by sealed images.
pkgname=shim-signed
pkgver=15.8
pkgrel=1
pkgdesc='Signed shim and MOK manager for Secure Boot'
arch=('x86_64' 'aarch64')
url='https://github.com/rhboot/shim'
license=('BSD-2-Clause' 'GPL-2.0-only')
makedepends=('git' 'make' 'openssl' 'sbsigntools' 'gnu-efi' 'xz')
source=("${url}/releases/download/${pkgver}/shim-${pkgver}.tar.bz2")
sha256sums=('SKIP')

build() {
    cd "${srcdir}/shim-${pkgver}"
    make EFIDIR=arch
}

package() {
    cd "${srcdir}/shim-${pkgver}"
    install -Dm0644 shimx64.efi "${pkgdir}/usr/share/shim-signed/shimx64.efi"
    install -Dm0644 mmx64.efi "${pkgdir}/usr/share/shim-signed/mmx64.efi"
    install -Dm0644 COPYRIGHT "${pkgdir}/usr/share/licenses/${pkgname}/COPYRIGHT"
}
